<Window x:Class="WeatherWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeatherWpfApp"
        mc:Ignorable="d"
        Title="Погода" Height="720" Width="920"
        Background="#F3F4F6" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель поиска -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Город:" VerticalAlignment="Center" FontSize="14" Foreground="#374151" Margin="0,0,8,0"/>
            <TextBox x:Name="CityTextBox" Text="Екатеринбург" Width="220" Height="32" 
                     VerticalContentAlignment="Center" Padding="8,0" FontSize="14"
                     Background="White" BorderBrush="#D1D5DB"/>
            <Button x:Name="LoadButton" Content="Обновить данные" Width="150" Height="32" 
                    Margin="10,0,0,0" Click="LoadButton_Click" FontSize="14"
                    Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <!-- Статус -->
        <TextBlock x:Name="StatusTextBlock" Grid.Row="1" Text="Введите город и нажмите «Обновить данные»." 
                   Foreground="#6B7280" Margin="0,0,0,14" FontSize="13"/>

        <!-- Список карточек по дням -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="DaysItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="12" Padding="24,20" Margin="0,0,0,16">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="1" Opacity="0.06"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Левая часть: число и месяц -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding DayNumber}" FontSize="36" FontWeight="Light" 
                                               Foreground="#111827" LineHeight="38" Margin="0,-4,10,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MonthName}" FontSize="13" Foreground="#9CA3AF"/>
                                        <TextBlock Text="{Binding DayLabel}" FontSize="13" Foreground="#9CA3AF"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Правая часть: шапка таблицы и 4 периода суток -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Заголовки столбцов -->
                                    <Grid Grid.Row="0" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="105"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="3" Text="Давление,&#x0a;мм рт. ст." FontSize="12" Foreground="#9CA3AF" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="Влажность" FontSize="12" Foreground="#9CA3AF" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="Ветер, м/с" FontSize="12" Foreground="#9CA3AF" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="Ощущается как" FontSize="12" Foreground="#9CA3AF" TextAlignment="Center"/>
                                    </Grid>

                                    <!-- Строки: Утром, Днём, Вечером, Ночью -->
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Periods}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="48"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="95"/>
                                                        <ColumnDefinition Width="85"/>
                                                        <ColumnDefinition Width="105"/>
                                                        <ColumnDefinition Width="105"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Время суток и диапазон температур -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding PeriodName}" FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                                        <TextBlock Text="{Binding TempRange}" FontSize="17" FontWeight="Medium" Foreground="#111827"/>
                                                    </StackPanel>

                                                    <!-- Картинка погоды (PNG) -->
                                                    <Image Grid.Column="1" Source="{Binding IconUrl}" Width="40" Height="40"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                                    <!-- Описание погоды -->
                                                    <TextBlock Grid.Column="2" Text="{Binding Condition}" FontSize="14" 
                                                               Foreground="#374151" VerticalAlignment="Center" Margin="8,0,0,0"/>

                                                    <!-- Давление -->
                                                    <TextBlock Grid.Column="3" Text="{Binding Pressure}" FontSize="14" 
                                                               Foreground="#111827" VerticalAlignment="Center" TextAlignment="Center"/>

                                                    <!-- Влажность -->
                                                    <TextBlock Grid.Column="4" Text="{Binding Humidity}" FontSize="14" 
                                                               Foreground="#111827" VerticalAlignment="Center" TextAlignment="Center"/>

                                                    <!-- Ветер + направление -->
                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding WindSpeed}" FontSize="14" Foreground="#111827" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding WindDir}" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Ощущается как -->
                                                    <TextBlock Grid.Column="6" Text="{Binding FeelsLike}" FontSize="14" 
                                                               Foreground="#111827" VerticalAlignment="Center" TextAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>